@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #10365C
skinparam ClassBorderColor #10365C
skinparam ClassBackgroundColor #F5F8FC
skinparam ClassHeaderBackgroundColor #E3ECF7
skinparam PackageBorderColor #10365C
skinparam PackageBackgroundColor #FBFCFE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ActorBorderColor #10365C
skinparam ParticipantBorderColor #10365C
skinparam ParticipantBackgroundColor #F5F8FC
skinparam SequenceLifeLineBorderColor #7A8CA5
skinparam SequenceGroupBorderColor #7A8CA5
skinparam SequenceGroupHeaderFontStyle bold
skinparam BoundaryBorderColor #10365C
skinparam BoundaryBackgroundColor #F5F8FC
skinparam EntityBorderColor #10365C
skinparam EntityBackgroundColor #F5F8FC
skinparam StateBorderColor #10365C
skinparam StateBackgroundColor #F5F8FC
skinparam ActivityBorderColor #10365C
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityDiamondBorderColor #10365C
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ComponentBorderColor #10365C
skinparam ComponentBackgroundColor #F5F8FC
skinparam NodeBorderColor #10365C
skinparam NodeBackgroundColor #FBFCFE
skinparam DatabaseBorderColor #10365C
skinparam DatabaseBackgroundColor #F5F8FC
skinparam RectangleBorderColor #10365C
skinparam stereotypeCBackgroundColor #E3ECF7
skinparam stereotypeABackgroundColor #E3ECF7
skinparam stereotypeEBackgroundColor #FFF3D6
skinparam class {
  BackgroundColor<<külső>> #EEEEEE
  BorderColor<<külső>> #9AA5B1
  FontColor<<külső>> #4B5563
}
title Relációs adatmodell – tartalom és külső adatok
hide circle
hide empty members
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
entity "places" as places {
  * id : INT <<PK>>
  --
  * name : VARCHAR(150)
  * category : ENUM
  description : VARCHAR(1000)
  * latitude : DECIMAL(9,6)
  * longitude : DECIMAL(9,6)
  opening_hours_text : VARCHAR(200)
  parent_id : INT <<FK>>
  * search_key : VARCHAR(150)
  * status : ENUM
  * created_by : INT <<FK>>
  * created_at : DATETIME
  * updated_at : DATETIME
  published_at : DATETIME
  * version : INT
}
entity "news_items" as news_items {
  * id : INT <<PK>>
  --
  * title : VARCHAR(200)
  * summary : TEXT
  * source_url : VARCHAR(500)
  * topic : VARCHAR(50)
  * news_date : DATE
  * status : ENUM
  * created_by : INT <<FK>>
  * created_at : DATETIME
  * updated_at : DATETIME
  published_at : DATETIME
  * version : INT
}
entity "events" as events {
  * id : INT <<PK>>
  --
  * title : VARCHAR(200)
  * description : TEXT
  * starts_at : DATETIME
  * ends_at : DATETIME
  * event_type : VARCHAR(50)
  faculty_id : INT <<FK>>
  * place_id : INT <<FK>>
  * organizer : VARCHAR(150)
  * status : ENUM
  * created_by : INT <<FK>>
  * created_at : DATETIME
  * updated_at : DATETIME
  published_at : DATETIME
  * version : INT
}
entity "canteens" as canteens {
  * id : INT <<PK>>
  --
  * name : VARCHAR(100)
  * place_id : INT <<FK>>
}
entity "canteen_opening_hours" as canteen_opening_hours {
  * id : INT <<PK>>
  --
  * canteen_id : INT <<FK>>
  * day_of_week : TINYINT
  * opens_at : TIME
  * closes_at : TIME
}
entity "canteen_closed_dates" as canteen_closed_dates {
  * canteen_id : INT <<PK>>
  * closed_date : DATE <<PK>>
  --
}
entity "daily_menus" as daily_menus {
  * id : INT <<PK>>
  --
  * canteen_id : INT <<FK>>
  * menu_date : DATE
  * title : VARCHAR(100)
  * status : ENUM
  * created_by : INT <<FK>>
  * created_at : DATETIME
  * updated_at : DATETIME
  published_at : DATETIME
  * version : INT
}
entity "dishes" as dishes {
  * id : INT <<PK>>
  --
  * daily_menu_id : INT <<FK>>
  * name : VARCHAR(150)
  * course : ENUM
  * price : INT
  * vegetarian : TINYINT(1)
  * sort_order : TINYINT
}
entity "dish_allergens" as dish_allergens {
  * dish_id : INT <<PK>>
  * allergen_code : TINYINT <<PK>>
  --
}
entity "parking_zones" as parking_zones {
  * id : INT <<PK>>
  --
  * name : VARCHAR(100)
  * place_id : INT <<FK>>
  * capacity : SMALLINT
  latest_reading_id : BIGINT <<FK>>
}
entity "sensor_devices" as sensor_devices {
  * id : INT <<PK>>
  --
  * name : VARCHAR(100)
  * zone_id : INT <<FK>>
  * key_hash : CHAR(64) <<UQ>>
  * active : TINYINT(1)
  last_seen_at : DATETIME
}
entity "parking_readings" as parking_readings {
  * id : BIGINT <<PK>>
  --
  * zone_id : INT <<FK>>
  * device_id : INT <<FK>>
  * occupied : SMALLINT
  * measured_at : DATETIME
  * received_at : DATETIME
}
entity "timetable_imports" as timetable_imports {
  * id : INT <<PK>>
  --
  * source : ENUM
  * started_at : DATETIME
  finished_at : DATETIME
  * status : ENUM
  valid_from : DATE
  valid_to : DATE
  message : VARCHAR(1000)
}
entity "stops" as stops {
  * id : INT <<PK>>
  --
  * source_id : VARCHAR(50) <<UQ>>
  * name : VARCHAR(100)
  place_id : INT <<FK>>
  * is_default : TINYINT(1)
}
entity "routes" as routes {
  * id : INT <<PK>>
  --
  * source_id : VARCHAR(50) <<UQ>>
  * short_name : VARCHAR(10)
  * vehicle_type : ENUM
}
entity "service_calendars" as service_calendars {
  * id : INT <<PK>>
  --
  * import_id : INT <<FK>>
  * source_id : VARCHAR(50)
  * monday … sunday : TINYINT(1)
  * start_date : DATE
  * end_date : DATE
}
entity "service_exceptions" as service_exceptions {
  * calendar_id : INT <<PK>>
  * exception_date : DATE <<PK>>
  --
  * runs : TINYINT(1)
}
entity "departures" as departures {
  * id : BIGINT <<PK>>
  --
  * import_id : INT <<FK>>
  * stop_id : INT <<FK>>
  * route_id : INT <<FK>>
  * calendar_id : INT <<FK>>
  * headsign : VARCHAR(100)
  * departure_time : TIME
}
entity "users" as users #EEEEEE {
  * id <<PK>>
}
entity "faculties" as faculties #EEEEEE {
  * id <<PK>>
}
places |o--o{ places
users ||--o{ places
users ||--o{ news_items
faculties |o--o{ events
places ||--o{ events
users ||--o{ events
places ||--o{ canteens
canteens ||--o{ canteen_opening_hours
canteens ||--o{ canteen_closed_dates
canteens ||--o{ daily_menus
users ||--o{ daily_menus
daily_menus ||--o{ dishes
dishes ||--o{ dish_allergens
places ||--o{ parking_zones
parking_readings |o--o{ parking_zones
parking_zones ||--o{ sensor_devices
parking_zones ||--o{ parking_readings
sensor_devices ||--o{ parking_readings
places |o--o{ stops
timetable_imports ||--o{ service_calendars
service_calendars ||--o{ service_exceptions
timetable_imports ||--o{ departures
stops ||--o{ departures
routes ||--o{ departures
service_calendars ||--o{ departures
@enduml
