title AppointmentRepository.bookSlot() – egyidejű foglalás
start
:Tranzakció indítása;
:SELECT … FROM slots WHERE id = ? FOR UPDATE
(az időpont sorának zárolása);
if (Az állapot szabad?) then (igen)
  :INSERT INTO bookings (…, status = 'ACTIVE');
  if (Egyedi index ütközés?) then (nem)
    :UPDATE slots SET status = 'BOOKED';
    :Értesítések sorba állítása (notifications);
    :COMMIT;
    :A foglalás visszaadása;
    stop
  else (igen: már van aktív foglalása az ügytípusra)
    :ROLLBACK;
    :„Már van aktív foglalása” (E2);
    stop
  endif
else (nem)
  :ROLLBACK;
  :„Az időpontot közben más lefoglalta” (E1);
  stop
endif
@enduml
