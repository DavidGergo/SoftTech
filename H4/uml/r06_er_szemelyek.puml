  letrehozva
  torles_oka
}
relationship RESZE {
}
relationship DOLGOZIK {
}
relationship MEGHIRDET <<identifying>> {
}
relationship FIOKJA {
}
relationship KAPJA {
}
relationship TANSZEKHEZ {
}
relationship SAVJAI {
}
relationship ELOALLITJA {
}
relationship FOGLAL {
}
relationship VONATKOZIK {
}
KAR -1- RESZE
RESZE -N- TANSZEK
