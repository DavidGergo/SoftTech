title Adatelérési réteg
left to right direction
class Database {
  - pool : mysql2.Pool
  + query(sql : String, params : Array) : Row[]
  + transaction(work : Function) : any
  + healthCheck() : Boolean
}
class Transaction {
  + query(sql : String, params : Array) : Row[]
  + commit()
  + rollback()
}
abstract class Repository<T> {
  # db : Database
  # table : String
  + findById(id : Integer, tx? : Transaction) : T
  # mapRow(row : Row) : T
  # insert(values : Object, tx? : Transaction) : Integer
  # update(id : Integer, values : Object, tx? : Transaction)
}
class UserRepository {
  + findByExternalId(externalId) : User
  + saveLogin(user)
  + findRoles(userId) : RoleAssignment[]
  + countAdmins(tx) : Integer
}
class SessionRepository {
  + create(session)
  + touch(id, now)
  + delete(id)
  + deleteExpired(before)
}
class ContentRepository<T extends Content> {
  + findPublished(filter) : T[]
  + save(item : T, expectedVersion : Integer) : Boolean
  + archive(id, by)
}
class PlaceRepository {
  + search(searchKey, category, limit) : Place[]
}
class EventRepository {
  + search(filter : EventFilter) : Event[]
}
class StaffRepository {
  + search(searchKey, facultyId, departmentId) : StaffProfile[]
  + saveProfile(profile, hours)
}
class ParkingRepository {
  + saveReading(reading)
  + zonesWithLatest() : ParkingZone[]
}
class TimetableRepository {
  + replaceImport(import, data)
  + nextDepartures(stopId, at, headsign, perRoute) : Departure[]
}
class AppointmentRepository {
  + freeSlots(caseTypeId, from, to) : Slot[]
  + bookSlot(slotId, studentId) : Booking
  + cancelBooking(bookingId, now)
  + saveRange(range, slots)
}
class FaultReportRepository {
  + create(report, attachment?) : FaultReport
  + listFor(user, filter) : FaultReport[]
  + addStatusChange(change)
  + nextCode(year, tx) : String
}
class NotificationRepository {
  + enqueue(notification)
  + due(now, limit) : Notification[]
  + markSent(id, at)
  + markFailed(id)
}
class AuditLogRepository {
  + record(entry)
  + search(filter) : AuditLogEntry[]
}
Database ..> Transaction : létrehoz
Repository --> Database
Repository <|-- UserRepository
Repository <|-- SessionRepository
Repository <|-- ContentRepository
ContentRepository <|-- PlaceRepository
ContentRepository <|-- EventRepository
Repository <|-- StaffRepository
Repository <|-- ParkingRepository
Repository <|-- TimetableRepository
Repository <|-- AppointmentRepository
Repository <|-- FaultReportRepository
Repository <|-- NotificationRepository
Repository <|-- AuditLogRepository
@enduml
