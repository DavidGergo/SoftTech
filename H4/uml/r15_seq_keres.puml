skinparam class {
  BackgroundColor<<külső>> #EEEEEE
  BorderColor<<külső>> #9AA5B1
  FontColor<<külső>> #4B5563
}
title PATCH /api/reports/42/status – rétegek
hide footbox
autonumber
participant "Böngésző" as B
participant "Nginx" as N
participant "Express\nrouter" as R
participant "auth\nmiddleware" as A
participant "ReportService" as S
participant "FaultReport-\nRepository" as FR
database "MySQL" as DB
B -> N : HTTPS kérés (munkamenet-süti, JSON)
N -> R : továbbítás (HTTP, localhost)
R -> A : requireRole(LECTURER, ADMIN)
A -> DB : munkamenet és szerepkörök
alt érvényes munkamenet és szerepkör
  A -> S : changeStatus(42, újÁllapot, megjegyzés, felhasználó)
  S -> FR : findById(42)
  FR -> DB : SELECT
  S -> S : canBeManagedBy(), K-44 ellenőrzése
  S -> FR : transaction: UPDATE + INSERT status_changes,\nnotifications, audit_log_entries
  FR -> DB : COMMIT
  S --> R : frissített bejelentés
  R --> B : 200 OK (JSON)
else lejárt munkamenet
  A --> B : 401 Unauthorized
else nincs jogosultság
  A --> B : 403 Forbidden
end
@enduml
