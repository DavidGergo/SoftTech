@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #10365C
skinparam ClassBorderColor #10365C
skinparam ClassBackgroundColor #F5F8FC
skinparam ClassHeaderBackgroundColor #E3ECF7
skinparam PackageBorderColor #10365C
skinparam PackageBackgroundColor #FBFCFE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ActorBorderColor #10365C
skinparam ParticipantBorderColor #10365C
skinparam ParticipantBackgroundColor #F5F8FC
skinparam SequenceLifeLineBorderColor #7A8CA5
skinparam SequenceGroupBorderColor #7A8CA5
skinparam SequenceGroupHeaderFontStyle bold
skinparam BoundaryBorderColor #10365C
skinparam BoundaryBackgroundColor #F5F8FC
skinparam EntityBorderColor #10365C
skinparam EntityBackgroundColor #F5F8FC
skinparam StateBorderColor #10365C
skinparam StateBackgroundColor #F5F8FC
skinparam ActivityBorderColor #10365C
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityDiamondBorderColor #10365C
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ComponentBorderColor #10365C
skinparam ComponentBackgroundColor #F5F8FC
skinparam NodeBorderColor #10365C
skinparam NodeBackgroundColor #FBFCFE
skinparam DatabaseBorderColor #10365C
skinparam DatabaseBackgroundColor #F5F8FC
skinparam RectangleBorderColor #10365C
skinparam stereotypeCBackgroundColor #E3ECF7
skinparam stereotypeABackgroundColor #E3ECF7
skinparam stereotypeEBackgroundColor #FFF3D6
skinparam class {
  BackgroundColor<<külső>> #EEEEEE
  BorderColor<<külső>> #9AA5B1
  FontColor<<külső>> #4B5563
}
title Relációs adatmodell – felhasználók, szervezet, ügyintézés
hide circle
hide empty members
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
entity "users" as users {
  * id : INT <<PK>>
  --
  * external_id : VARCHAR(64) <<UQ>>
  * name : VARCHAR(150)
  * email : VARCHAR(254) <<UQ>>
  * disabled : TINYINT(1)
  disabled_reason : VARCHAR(500)
  * first_login_at : DATETIME
  * last_login_at : DATETIME
}
entity "role_assignments" as role_assignments {
  * id : INT <<PK>>
  --
  * user_id : INT <<FK>>
  * role : ENUM
  department_id : INT <<FK>>
  granted_by : INT <<FK>>
  * granted_at : DATETIME
}
entity "sessions" as sessions {
  * id : CHAR(64) <<PK>>
  --
  * user_id : INT <<FK>>
  * created_at : DATETIME
  * last_activity_at : DATETIME
  return_url : VARCHAR(500)
}
entity "audit_log_entries" as audit_log_entries {
  * id : BIGINT <<PK>>
  --
  * actor_id : INT <<FK>>
  * action : VARCHAR(50)
  * entity_type : VARCHAR(50)
  * entity_id : INT
  details : TEXT
  * created_at : DATETIME
}
entity "notifications" as notifications {
  * id : INT <<PK>>
  --
  * recipient_id : INT <<FK>>
  * type : ENUM
  * subject : VARCHAR(200)
  * body : TEXT
  booking_id : INT <<FK>>
  fault_report_id : INT <<FK>>
  * scheduled_at : DATETIME
  sent_at : DATETIME
  * attempts : TINYINT
}
entity "faculties" as faculties {
  * id : INT <<PK>>
  --
  * name : VARCHAR(150) <<UQ>>
  * short_name : VARCHAR(20)
}
entity "departments" as departments {
  * id : INT <<PK>>
  --
  * faculty_id : INT <<FK>>
  * name : VARCHAR(150)
}
entity "staff_profiles" as staff_profiles {
  * id : INT <<PK>>
  --
  * name : VARCHAR(150)
  * email : VARCHAR(254)
  * department_id : INT <<FK>>
  office_place_id : INT <<FK>>
  office_text : VARCHAR(100)
  note : VARCHAR(300)
  user_id : INT <<FK>>
  * search_key : VARCHAR(150)
  * updated_at : DATETIME
}
entity "office_hours" as office_hours {
  * id : INT <<PK>>
  --
  * staff_profile_id : INT <<FK>>
  * day_of_week : TINYINT
  * start_time : TIME
  * end_time : TIME
  note : VARCHAR(200)
}
entity "case_types" as case_types {
  * id : INT <<PK>>
  --
  * name : VARCHAR(100) <<UQ>>
  description : VARCHAR(500)
  * location : VARCHAR(200)
  * slot_minutes : SMALLINT
  * active : TINYINT(1)
}
entity "slot_ranges" as slot_ranges {
  * id : INT <<PK>>
  --
  * case_type_id : INT <<FK>>
  * start_date : DATE
  * start_time : TIME
  * end_time : TIME
  repeat_until : DATE
  * created_by : INT <<FK>>
}
entity "slots" as slots {
  * id : INT <<PK>>
  --
  * range_id : INT <<FK>>
  * case_type_id : INT <<FK>>
  * starts_at : DATETIME
  * ends_at : DATETIME
  * status : ENUM
}
entity "bookings" as bookings {
  * id : INT <<PK>>
  --
  * student_id : INT <<FK>>
  * slot_id : INT <<FK>>
  * case_type_id : INT <<FK>>
  * status : ENUM
  * created_at : DATETIME
  cancelled_at : DATETIME
  delete_reason : VARCHAR(500)
  active_slot : INT <<UQ>>
  active_case : VARCHAR(30) <<UQ>>
}
entity "places" as places #EEEEEE {
  * id <<PK>>
}
entity "fault_reports" as fault_reports #EEEEEE {
  * id <<PK>>
}
users ||--o{ role_assignments
departments |o--o{ role_assignments
users |o--o{ role_assignments
users ||--o{ sessions
users ||--o{ audit_log_entries
users ||--o{ notifications
bookings |o--o{ notifications
fault_reports |o--o{ notifications
faculties ||--o{ departments
departments ||--o{ staff_profiles
places |o--o{ staff_profiles
users |o--o| staff_profiles
staff_profiles ||--o{ office_hours
case_types ||--o{ slot_ranges
users ||--o{ slot_ranges
slot_ranges ||--o{ slots
case_types ||--o{ slots
users ||--o{ bookings
slots ||--o{ bookings
case_types ||--o{ bookings
@enduml
