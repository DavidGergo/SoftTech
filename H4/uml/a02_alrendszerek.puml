@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #10365C
skinparam ClassBorderColor #10365C
skinparam ClassBackgroundColor #F5F8FC
skinparam ClassHeaderBackgroundColor #E3ECF7
skinparam PackageBorderColor #10365C
skinparam PackageBackgroundColor #FBFCFE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ActorBorderColor #10365C
skinparam ParticipantBorderColor #10365C
skinparam ParticipantBackgroundColor #F5F8FC
skinparam SequenceLifeLineBorderColor #7A8CA5
skinparam SequenceGroupBorderColor #7A8CA5
skinparam SequenceGroupHeaderFontStyle bold
skinparam BoundaryBorderColor #10365C
skinparam BoundaryBackgroundColor #F5F8FC
skinparam EntityBorderColor #10365C
skinparam EntityBackgroundColor #F5F8FC
skinparam StateBorderColor #10365C
skinparam StateBackgroundColor #F5F8FC
skinparam ActivityBorderColor #10365C
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityDiamondBorderColor #10365C
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ComponentBorderColor #10365C
skinparam ComponentBackgroundColor #F5F8FC
skinparam NodeBorderColor #10365C
skinparam NodeBackgroundColor #FBFCFE
skinparam DatabaseBorderColor #10365C
skinparam DatabaseBackgroundColor #F5F8FC
skinparam RectangleBorderColor #10365C
skinparam stereotypeCBackgroundColor #E3ECF7
skinparam stereotypeABackgroundColor #E3ECF7
skinparam stereotypeEBackgroundColor #FFF3D6
skinparam class {
  BackgroundColor<<külső>> #EEEEEE
  BorderColor<<külső>> #9AA5B1
  FontColor<<külső>> #4B5563
}
title A Vezérlőpult alrendszerei és együttműködésük
skinparam packageStyle folder
skinparam nodesep 50
skinparam ranksep 70
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #9AA5B1
package "Felhasználókezelés" as S1 #FDF3E1 {
  rectangle "User, RoleAssignment, Role,\nSession, AuditLogEntry,\nNotification, NotificationType" as C1
}
package "Szervezet és oktatók" as S2 #F1ECFB {
  rectangle "Faculty, Department,\nStaffProfile, OfficeHour" as C2
}
package "Tartalomkezelés" as S3 #E8F1FB {
  rectangle "Content, NewsItem, Event,\nPlace, Canteen, OpeningHours,\nDailyMenu, Dish" as C3
}
package "Külső adatok" as S4 #E6F6F4 {
  rectangle "ParkingZone, ParkingReading,\nSensorDevice, Stop, Route,\nDeparture, TimetableImport" as C4
}
package "Ügyintézés" as S5 #E9F7EC {
  rectangle "CaseType, SlotRange,\nSlot, Booking" as C5
}
package "Hibabejelentés" as S6 #FBEAEA {
  rectangle "FaultReport, ReportCategory,\nResponsibleUnit, AssignmentRule,\nStatusChange, Attachment" as C6
}
rectangle "Egyetemi azonosító\nszolgáltatás" as IdP <<külső rendszer>>
rectangle "E-mail-szolgáltatás" as Mail <<külső rendszer>>
rectangle "Parkolóérzékelő-\nrendszer" as Sens <<külső rendszer>>
rectangle "Menetrend-adatforrás\n(MVK)" as MVK <<külső rendszer>>

IdP --> S1 : azonosító, név, e-mail
S1 --> Mail : értesítések
Sens --> S4 : mérések
MVK --> S4 : menetrend (GTFS)
S2 ..> S1 : fiók, szerepkör
S2 ..> S3 : iroda helye
S3 ..> S1 : létrehozó adminisztrátor
S3 ..> S2 : esemény kara
S4 ..> S3 : zóna és megálló helye
S5 ..> S1 : hallgató, értesítés, napló
S6 ..> S1 : bejelentő, értesítés, napló
S6 ..> S2 : felelős tanszék
S6 ..> S3 : épület
@enduml
