title A Vezérlőpult képernyői és a navigáció
left to right direction
skinparam rectangleBackgroundColor #F5F8FC
rectangle "Kezdőlap\n(kártyák)" as Home
package "Mindenki" #E8F1FB {
  rectangle "Térkép" as Map
  rectangle "Parkolás" as Park
  rectangle "Események" as Ev
  rectangle "Hírek" as News
  rectangle "Menza" as Can
  rectangle "Menetrend" as Tr
  rectangle "Oktatók" as Staff
  rectangle "Súgó" as Help
}
package "Hallgató, oktató" #E9F7EC {
  rectangle "Ügyintézés:\nÚj foglalás" as NewB
  rectangle "Foglalásaim" as MyB
  rectangle "Hibabejelentés:\nÚj bejelentés" as NewR
  rectangle "Bejelentéseim" as MyR
}
package "Oktató" #F1ECFB {
  rectangle "Oktatói adatlapom" as MyProf
}
package "Oktató, adminisztrátor" #FBEAEA {
  rectangle "Bejelentések kezelése" as Manage
}
package "Adminisztrátor" #FDF3E1 {
  rectangle "Adminisztráció:\nTartalom" as ACont
  rectangle "Adminisztráció:\nIdőpontok" as ASlots
  rectangle "Adminisztráció:\nFelhasználók" as AUsers
  rectangle "Adminisztráció:\nNapló" as ALog
}
rectangle "Egyetemi\nbejelentkezés" as Login #EEEEEE
Home --> Map
Home --> Can
Home --> Tr
Home --> Ev
Home --> News
Home --> Login : „Bejelentkezés”
Ev ..> Map : helyszín
Staff ..> Map : iroda
Tr ..> Map : megálló
Park ..> Map : zóna
Map ..> NewR : „Hiba bejelentése itt”
NewB ..> MyB : visszaigazolás után
MyB ..> NewB : lemondás után új foglalás
NewR ..> MyR : beküldés után
Manage ..> MyR : (a bejelentő értesítést kap)
@enduml
