@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #10365C
skinparam ClassBorderColor #10365C
skinparam ClassBackgroundColor #F5F8FC
skinparam ClassHeaderBackgroundColor #E3ECF7
skinparam PackageBorderColor #10365C
skinparam PackageBackgroundColor #FBFCFE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ActorBorderColor #10365C
skinparam ParticipantBorderColor #10365C
skinparam ParticipantBackgroundColor #F5F8FC
skinparam SequenceLifeLineBorderColor #7A8CA5
skinparam SequenceGroupBorderColor #7A8CA5
skinparam SequenceGroupHeaderFontStyle bold
skinparam BoundaryBorderColor #10365C
skinparam BoundaryBackgroundColor #F5F8FC
skinparam EntityBorderColor #10365C
skinparam EntityBackgroundColor #F5F8FC
skinparam StateBorderColor #10365C
skinparam StateBackgroundColor #F5F8FC
skinparam ActivityBorderColor #10365C
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityDiamondBorderColor #10365C
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ComponentBorderColor #10365C
skinparam ComponentBackgroundColor #F5F8FC
skinparam NodeBorderColor #10365C
skinparam NodeBackgroundColor #FBFCFE
skinparam DatabaseBorderColor #10365C
skinparam DatabaseBackgroundColor #F5F8FC
skinparam RectangleBorderColor #10365C
skinparam stereotypeCBackgroundColor #E3ECF7
skinparam stereotypeABackgroundColor #E3ECF7
skinparam stereotypeEBackgroundColor #FFF3D6
skinparam class {
  BackgroundColor<<külső>> #EEEEEE
  BorderColor<<külső>> #9AA5B1
  FontColor<<külső>> #4B5563
}
title Hibabejelentés alrendszer – az analízis modell osztálydiagramja
hide <<külső>> members
package "Hibabejelentés" <<Rectangle>> {
class FaultReport {
  id : Integer
  code : String
  reporter : User
  category : ReportCategory
  building : Place
  locationDetail : String
  latitude, longitude : Decimal
  description : String
  status : ReportStatus
  unit : ResponsibleUnit
  createdAt : DateTime
  --
  submit()
  changeStatus(newStatus, comment, by)
  addComment(comment, by)
  reassign(unit, by)
  canBeViewedBy(user) : Boolean
  canBeManagedBy(user) : Boolean
  {static} listFor(user, filter) : FaultReport[]
  {static} nextCode(year) : String
}
enum ReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}
class ReportCategory {
  id : Integer
  name : String
  defaultUnit : ResponsibleUnit
}
class ResponsibleUnit {
  id : Integer
  name : String
  email : String
  department : Department
  --
  {static} resolve(category, building) : ResponsibleUnit
}
class AssignmentRule {
  category : ReportCategory
  building : Place
  unit : ResponsibleUnit
  --
  matches(category, building) : Boolean
}
class StatusChange {
  report : FaultReport
  fromStatus : ReportStatus
  toStatus : ReportStatus
  comment : String
  changedBy : User
  changedAt : DateTime
  --
  isStatusChange() : Boolean
}
class Attachment {
  fileName : String
  mimeType : String
  sizeBytes : Integer
  storagePath : String
  width, height : Integer
  --
  {static} validate(file) : Boolean
  {static} store(file) : Attachment
}
}
class User <<külső>>
class Place <<külső>>
class Department <<külső>>
class Notification <<külső>>
FaultReport "0..*" --> "1" User : bejelentő
FaultReport "0..*" --> "1" ReportCategory
FaultReport "0..*" --> "1" Place : épület
FaultReport "0..*" --> "1" ResponsibleUnit : felelős
FaultReport "1" *-- "0..1" Attachment : képe
FaultReport "1" *-- "1..*" StatusChange : előzmények
FaultReport "0..*" --> "1" ReportStatus
StatusChange "0..*" --> "1" User : módosító
ReportCategory "0..*" --> "1" ResponsibleUnit : alapértelmezett
ResponsibleUnit "0..*" --> "0..1" Department
AssignmentRule "0..*" --> "1" ReportCategory
AssignmentRule "0..*" --> "1" Place : épület
AssignmentRule "0..*" --> "1" ResponsibleUnit
FaultReport ..> Notification : kivált
@enduml
