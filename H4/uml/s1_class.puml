@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #10365C
skinparam ClassBorderColor #10365C
skinparam ClassBackgroundColor #F5F8FC
skinparam ClassHeaderBackgroundColor #E3ECF7
skinparam PackageBorderColor #10365C
skinparam PackageBackgroundColor #FBFCFE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ActorBorderColor #10365C
skinparam ParticipantBorderColor #10365C
skinparam ParticipantBackgroundColor #F5F8FC
skinparam SequenceLifeLineBorderColor #7A8CA5
skinparam SequenceGroupBorderColor #7A8CA5
skinparam SequenceGroupHeaderFontStyle bold
skinparam BoundaryBorderColor #10365C
skinparam BoundaryBackgroundColor #F5F8FC
skinparam EntityBorderColor #10365C
skinparam EntityBackgroundColor #F5F8FC
skinparam StateBorderColor #10365C
skinparam StateBackgroundColor #F5F8FC
skinparam ActivityBorderColor #10365C
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityDiamondBorderColor #10365C
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ComponentBorderColor #10365C
skinparam ComponentBackgroundColor #F5F8FC
skinparam NodeBorderColor #10365C
skinparam NodeBackgroundColor #FBFCFE
skinparam DatabaseBorderColor #10365C
skinparam DatabaseBackgroundColor #F5F8FC
skinparam RectangleBorderColor #10365C
skinparam stereotypeCBackgroundColor #E3ECF7
skinparam stereotypeABackgroundColor #E3ECF7
skinparam stereotypeEBackgroundColor #FFF3D6
skinparam class {
  BackgroundColor<<külső>> #EEEEEE
  BorderColor<<külső>> #9AA5B1
  FontColor<<külső>> #4B5563
}
title Felhasználókezelés alrendszer – az analízis modell osztálydiagramja
hide <<külső>> members
package "Felhasználókezelés" <<Rectangle>> {
class User {
  id : Integer
  externalId : String
  name : String
  email : String
  disabled : Boolean
  firstLoginAt : DateTime
  lastLoginAt : DateTime
  --
  {static} findByExternalId(externalId) : User
  {static} register(externalId, name, email) : User
  recordLogin()
  hasRole(role) : Boolean
  grantRole(role, department, grantedBy) : RoleAssignment
  revokeRole(role, revokedBy)
  disable(reason, by)
  getStaffProfile() : StaffProfile
}
enum Role {
  STUDENT
  LECTURER
  ADMIN
}
class RoleAssignment {
  role : Role
  department : Department
  grantedBy : User
  grantedAt : DateTime
  --
  isValid() : Boolean
}
class Session {
  id : String
  user : User
  createdAt : DateTime
  lastActivityAt : DateTime
  returnUrl : String
  --
  {static} start(user, returnUrl) : Session
  touch(now)
  isExpired(now) : Boolean
  end()
}
class AuditLogEntry {
  id : Integer
  actor : User
  action : String
  entityType : String
  entityId : Integer
  details : String
  createdAt : DateTime
  --
  {static} record(actor, action, entity, details) : AuditLogEntry
  {static} search(actor, entityType, from, to) : AuditLogEntry[]
}
class Notification {
  id : Integer
  recipient : User
  type : NotificationType
  subject : String
  body : String
  scheduledAt : DateTime
  sentAt : DateTime
  attempts : Integer
  --
  {static} create(recipient, type, data) : Notification
  send() : Boolean
  isDue(now) : Boolean
}
enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_DELETED
  REPORT_STATUS_CHANGED
}
}
class Department <<külső>>
class StaffProfile <<külső>>
User "1" *-- "0..*" RoleAssignment : szerepkörei
RoleAssignment "0..*" --> "1" Role
RoleAssignment "0..*" --> "0..1" Department : tanszék
User "1" -- "0..*" Session : munkamenetei
AuditLogEntry "0..*" --> "1" User : végrehajtó
Notification "0..*" --> "1" User : címzett
Notification "0..*" --> "1" NotificationType
StaffProfile "0..1" -- "0..1" User : fiókja
@enduml
