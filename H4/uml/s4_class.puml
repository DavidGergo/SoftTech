@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #10365C
skinparam ClassBorderColor #10365C
skinparam ClassBackgroundColor #F5F8FC
skinparam ClassHeaderBackgroundColor #E3ECF7
skinparam PackageBorderColor #10365C
skinparam PackageBackgroundColor #FBFCFE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ActorBorderColor #10365C
skinparam ParticipantBorderColor #10365C
skinparam ParticipantBackgroundColor #F5F8FC
skinparam SequenceLifeLineBorderColor #7A8CA5
skinparam SequenceGroupBorderColor #7A8CA5
skinparam SequenceGroupHeaderFontStyle bold
skinparam BoundaryBorderColor #10365C
skinparam BoundaryBackgroundColor #F5F8FC
skinparam EntityBorderColor #10365C
skinparam EntityBackgroundColor #F5F8FC
skinparam StateBorderColor #10365C
skinparam StateBackgroundColor #F5F8FC
skinparam ActivityBorderColor #10365C
skinparam ActivityBackgroundColor #F5F8FC
skinparam ActivityDiamondBorderColor #10365C
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ComponentBorderColor #10365C
skinparam ComponentBackgroundColor #F5F8FC
skinparam NodeBorderColor #10365C
skinparam NodeBackgroundColor #FBFCFE
skinparam DatabaseBorderColor #10365C
skinparam DatabaseBackgroundColor #F5F8FC
skinparam RectangleBorderColor #10365C
skinparam stereotypeCBackgroundColor #E3ECF7
skinparam stereotypeABackgroundColor #E3ECF7
skinparam stereotypeEBackgroundColor #FFF3D6
skinparam class {
  BackgroundColor<<külső>> #EEEEEE
  BorderColor<<külső>> #9AA5B1
  FontColor<<külső>> #4B5563
}
title Külső adatok alrendszer – az analízis modell osztálydiagramja
hide <<külső>> members
package "Külső adatok" <<Rectangle>> {
class ParkingZone {
  id : Integer
  name : String
  place : Place
  capacity : Integer
  latestReading : ParkingReading
  --
  applyReading(reading)
  freeSpaces() : Integer
  availabilityLevel() : String
  dataState(now) : ParkingDataState
}
class ParkingReading {
  zone : ParkingZone
  device : SensorDevice
  occupied : Integer
  measuredAt : DateTime
  receivedAt : DateTime
  --
  isValid() : Boolean
}
class SensorDevice {
  id : Integer
  name : String
  zone : ParkingZone
  keyHash : String
  active : Boolean
  lastSeenAt : DateTime
  --
  authenticate(key) : Boolean
  submitReading(occupied, measuredAt) : ParkingReading
}
enum ParkingDataState {
  FRESH
  STALE
  NO_DATA
}
class Stop {
  id : Integer
  sourceId : String
  name : String
  place : Place
  isDefault : Boolean
  --
  nextDepartures(at, headsign, perRoute) : Departure[]
  headsigns() : String[]
}
class Route {
  id : Integer
  sourceId : String
  shortName : String
  vehicleType : String
}
class Departure {
  stop : Stop
  route : Route
  headsign : String
  departureTime : Time
  serviceDays : String
  import : TimetableImport
  --
  runsOn(date) : Boolean
  minutesUntil(now) : Integer
}
class TimetableImport {
  id : Integer
  source : String
  startedAt : DateTime
  finishedAt : DateTime
  status : String
  validFrom : Date
  validTo : Date
  message : String
  --
  run() : Boolean
  {static} current() : TimetableImport
  isStale(now) : Boolean
}
}
class Place <<külső>>
ParkingZone "0..*" --> "1" Place : helye
ParkingZone "1" *-- "0..*" ParkingReading : mérései
SensorDevice "0..*" --> "1" ParkingZone : figyeli
SensorDevice "1" -- "0..*" ParkingReading : küldte
ParkingZone ..> ParkingDataState
Stop "0..*" --> "0..1" Place : térképi hely
Stop "1" -- "0..*" Departure
Route "1" -- "0..*" Departure
TimetableImport "1" *-- "0..*" Departure : betöltötte
@enduml
