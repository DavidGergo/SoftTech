title Szervezet és oktatók alrendszer – az analízis modell osztálydiagramja
hide <<külső>> members
package "Szervezet és oktatók" <<Rectangle>> {
class Faculty {
  id : Integer
  name : String
  shortName : String
  --
  getDepartments() : Department[]
}
class Department {
  id : Integer
  name : String
  faculty : Faculty
  --
  getStaff() : StaffProfile[]
}
class StaffProfile {
  id : Integer
  name : String
  email : String
  department : Department
  office : Place
  officeText : String
  note : String
  user : User
  updatedAt : DateTime
  --
  {static} search(query, faculty, department) : StaffProfile[]
  updateOffice(office, officeText)
  setNote(text)
  setOfficeHours(hours)
  validate() : Boolean
  assignTo(user)
}
class OfficeHour {
  dayOfWeek : Integer
  startTime : Time
  endTime : Time
  note : String
  --
  isValid() : Boolean
  overlaps(other) : Boolean
}
}
class Place <<külső>>
class User <<külső>>
Faculty "1" *-- "1..*" Department
StaffProfile "0..*" --> "1" Department : dolgozik
StaffProfile "1" *-- "0..*" OfficeHour : fogadóórái
StaffProfile "0..*" --> "0..1" Place : iroda
StaffProfile "0..1" -- "0..1" User : fiókja
@enduml
